# =============================================================
# news-collector · 환경변수 템플릿
# -------------------------------------------------------------
# 사용법
#   1. 이 파일을 .env 로 복사:   cp .env.example .env
#   2. 각 값 채우기 (주석 참고)
#   3. collector.py 는 python-dotenv 가 설치돼 있으면 자동 로드
#
# 주의
#   · .env 는 .gitignore 로 제외됨 — 절대 커밋 금지
#   · GitHub Actions 는 repository secrets 를 사용 (이 파일 불필요)
#     Settings → Secrets and variables → Actions 에 등록
# =============================================================

# -------------------------------------------------------------
# 필수 ① — Google OAuth 토큰 (JSON 한 줄)
# get_token.py 를 로컬에서 1회 실행하면 아래 형식의 결과가 나옵니다.
# 반드시 한 줄로 붙여넣으세요. (개행 금지)
# -------------------------------------------------------------
GOOGLE_OAUTH_TOKEN={"client_id":"...","client_secret":"...","refresh_token":"...","token_uri":"https://oauth2.googleapis.com/token"}

# -------------------------------------------------------------
# 필수 ② — Gemini API 키
# https://aistudio.google.com/apikey 에서 발급
# 미설정 시 AI 요약이 fallback (단순 추출) 로 동작
# -------------------------------------------------------------
GEMINI_API_KEY=

# -------------------------------------------------------------
# 필수 ③ — Google Drive 폴더 ID
# 수집 결과 스프레드시트가 저장될 Drive 폴더의 ID
# 폴더 URL: https://drive.google.com/drive/folders/{ID}
# -------------------------------------------------------------
GDRIVE_FOLDER_ID=

# -------------------------------------------------------------
# 선택 — 특정 스프레드시트를 직접 지정 (없으면 연도별 자동 생성)
# 시트 URL: https://docs.google.com/spreadsheets/d/{ID}/edit
# -------------------------------------------------------------
GDRIVE_SPREADSHEET_ID=

# -------------------------------------------------------------
# 선택 — get_token.py 에서 사용하는 Google OAuth 클라이언트
# (로컬에서 토큰 1회 발급할 때만 필요)
# Google Cloud Console → APIs & Services → Credentials 에서 발급
# -------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
